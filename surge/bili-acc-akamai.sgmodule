#!name=Bili Acc (Akamai Media)
#!desc=Optional native-app media rewriting for the shared akamaized.net CDN. Enable only when Bilibili traffic actually uses this domain.
#!arguments=server:https://bili.example.com,token:12345
#!arguments-desc=Set the public HTTPS server origin and matching token. This module MITMs all akamaized.net hosts.

[Script]
bili-acc-akamai-request = type=http-request,pattern=^https?://(?:[^./?#:]+\.)*akamaized\.net(?::\d+)?(?:/|$),script-path=https://raw.githubusercontent.com/JohnsonRan/Bili-Acc/main/surge/bili-acc-media-request.js,argument="{{{server}}}|{{{token}}}",timeout=5,debug=true

[MITM]
hostname = %APPEND% akamaized.net, *.akamaized.net
